{
  "require": {
    "php": ">=8.4",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "ShoesShop\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testdox",
    "php-cs-fixer": "vendor/bin/php-cs-fixer",
    "db:init": "php bin/db-init.php",
    "og:generate": "php bin/generate-og.php"
  }
}
